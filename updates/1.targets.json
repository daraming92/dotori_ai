{"signatures":[{"keyid":"34c39d818f277dab7803f3d9cdc1b76848477f5070b519a9a6c48363c12cbd26","sig":"0f7ab550cdd02289fb9d2402a6a2cef65d6a382fce2dc28a512ab9b34df0e1c32efb15198b2f381beaa5f9c79b2975465d910bfa3117db5bcef25a11f5397e0f"}],"signed":{"_type":"targets","expires":"2026-11-08T02:58:29Z","spec_version":"1.0.31","targets":{"DotoliAI-stable.exe":{"custom":{"channel":"stable","notes":"# \ub3c4\ud1a8\uc774 AI v1.0\n\n\ubb34\ub8cc \ubc30\ud3ec\ub97c \uc704\ud55c \uccab \uacf5\uac1c \ubc84\uc804\uc785\ub2c8\ub2e4. \uae30\uc874 \uc791\uc131\u00b7\ubd84\uc11d \uae30\ub2a5\uacfc \ub0b4 \ube14\ub85c\uadf8 \uc2a4\ud0c0\uc77c, \uc791\uc131 \ubaa8\ub4dc \ubc0f \uae00 \uad6c\uc131 \uc120\ud0dd\uc744 \uc720\uc9c0\ud569\ub2c8\ub2e4.\n\n- \uc124\uce58 \ud654\uba74\uc5d0\uc11c Microsoft \ub7f0\ud0c0\uc784 \uc774\uc6a9 \uc870\uac74\uc744 \ud655\uc778\ud558\uace0 \ub3d9\uc758 \uc5ec\ubd80\ub97c \uc120\ud0dd\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc624\ud508\uc18c\uc2a4 \ub77c\uc774\ube0c\ub7ec\ub9ac\uc758 \uad50\uccb4\u00b7\uc218\uc815 \uad8c\ub9ac\ub294 \uc720\uc9c0\ub429\ub2c8\ub2e4.\n\n- \uc0ac\uc6a9\uc790 \ubc84\uc804 \ud45c\uc2dc\ub97c v1.0\uc73c\ub85c \ud1b5\uc77c\ud588\uc2b5\ub2c8\ub2e4. \uc774\ud6c4 v1.1, v1.2 \uc21c\uc73c\ub85c \uc548\ub0b4\ud569\ub2c8\ub2e4.\n- \uc0c8 \ucd08\uc548\uc5d0\uc11c \uc18c\uc81c\ubaa9\uc774 \ubcf8\ubb38 \uccab \uc904\uc5d0 \ub2e4\uc2dc \ub098\uc624\ub294 \uc911\ubcf5 \ud45c\uc2dc\ub97c \uc815\ub9ac\ud588\uc2b5\ub2c8\ub2e4. \uae30\uc874 \uc800\uc7a5 \uae00\uacfc \uc9c1\uc811 \uc218\uc815\ud55c \uae00\uc740 \uc790\ub3d9 \ubcc0\uacbd\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.\n- \uacf5\uc9c0 33\uac1c \ubaa8\ub450\uc5d0\uc11c \uc0ac\uc6a9 \uc21c\uc11c\u00b7\ud655\uc778\ud560 \ub0b4\uc6a9\u00b7\uc8fc\uc758\ud560 \uc810\uc744 \ud655\uc778\ud558\uace0 \uac80\uc0c9\ud560 \uc218 \uc788\ub3c4\ub85d \uc548\ub0b4 \ub204\ub77d\uc744 \ubcf4\uc644\ud588\uc2b5\ub2c8\ub2e4.\n- AI \uc5f0\uacb0 \ubaa8\ub4c8\uc744 Codex 0.156.0\uc73c\ub85c \uac31\uc2e0\ud558\uace0, \uae30\ubcf8 \uc120\ud0dd \ubaa8\ub378 GPT-6 Astra\ub97c \uc571\uc5d0\uc11c \uba85\uc2dc\ud558\ub3c4\ub85d \ud588\uc2b5\ub2c8\ub2e4. \uc2e4\uc81c \uc0ac\uc6a9\ud560 \uc218 \uc788\ub294 \ubaa8\ub378\uc740 \uacc4\uc815\u00b7\uc81c\uacf5\uc790 \uc0c1\ud0dc\uc5d0 \ub530\ub77c \ub2e4\ub985\ub2c8\ub2e4.\n- \uc791\uc5c5 \uc804 \uc2e4\uc81c \uc5f0\uacb0\uc744 \ud655\uc778\ud558\uace0 \ub85c\uadf8\uc778\u00b7\ud55c\ub3c4\u00b7\ubaa8\ub4c8 \ud638\ud658\uc131\u00b7\ub124\ud2b8\uc6cc\ud06c \uc624\ub958\ub97c \uad6c\ubd84\ud569\ub2c8\ub2e4. \uc5f0\uacb0 \uc124\uc815\uc5d0\uc11c \uc9c0\uc6d0 \ubaa8\ub378\uc744 \ud655\uc778\ud558\uace0 \uc9c1\uc811 \ubcc0\uacbd\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n- \uc5f0\uacb0 \uc624\ub958 \uc774\ud6c4 \uc800\uc7a5\ub41c \uc791\uc5c5\uc73c\ub85c \ub3cc\uc544\uac00\ub294 \uc548\ub0b4\ub97c \ucd94\uac00\ud588\uc2b5\ub2c8\ub2e4. \uae30\uc874 \uacb0\uacfc\ub97c \ubcf4\uc874\ud558\uba70, \ubaa8\ub378\uc744 \uc784\uc758\ub85c \ubc14\uafb8\uac70\ub098 \uc0c8 \uae00 \uc0dd\uc131\uc744 \ubb34\uc870\uac74 \ub2e4\uc2dc \uc2e4\ud589\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.\n- \uc77c\ubc18 \ucc3d\uc73c\ub85c \ub113\uac8c \uc2dc\uc791\ud558\uace0 \uc791\uc740 \ud654\uba74\uc5d0\uc11c\ub294 \ud654\uba74 \ud06c\uae30\uc5d0 \ub9de\ucdb0 \uc870\uc808\ud569\ub2c8\ub2e4.\n- \ube14\ub85c\uadf8 \uce74\ud14c\uace0\ub9ac\ub97c \uc800\uc7a5\ud558\uba74 \uc0c1\ub2e8 \ube14\ub85c\uadf8 \uc120\ud0dd \ubc14\uc5d0\ub3c4 \uac19\uc740 \uce74\ud14c\uace0\ub9ac\uac00 \ud45c\uc2dc\ub429\ub2c8\ub2e4.\n- \uc81c\uacf5\ub41c \ud751\ubc31 \ub3c4\ud1a0\ub9ac \uadf8\ub9bc\uc73c\ub85c \ud504\ub85c\uadf8\ub7a8\u00b7\uc124\uce58\u00b7\ubc14\ub85c\uac00\uae30 \uc544\uc774\ucf58\uc744 \ud1b5\uc77c\ud558\uace0 \ubaa8\uc11c\ub9ac\ub97c \ub465\uae00\uac8c \uc801\uc6a9\ud588\uc2b5\ub2c8\ub2e4.\n- \ucd5c\uc885 \uac80\uc218\uc758 \u2018\uc911\uc9c0 \u00b7 \uc800\uc7a5 \uc720\uc9c0\u2019 \uc606\uc5d0\uc11c \u2018\uc774\ubbf8\uc9c0 \uc0dd\uc131 \ud504\ub86c\ud504\ud2b8 \ubcf5\uc0ac\u2019\ub97c \uc0ac\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ubcf5\uc0ac\ud55c \uc591\uc2dd \ub05d\uc5d0 \uc81c\ubaa9\uacfc \ubcf8\ubb38\uc744 \ubd99\uc5ec \ub123\uc5b4 \uc0ac\uc6a9\ud558\uc138\uc694.\n- \uae30\uc874 \uc791\uc5c5 \ub370\uc774\ud130\uc640 \uc2b9\uc778\ub41c \uc2e4\ud589 \uaddc\uce59\uc744 \uc720\uc9c0\ud569\ub2c8\ub2e4. \uc0c8 \uc0ac\uc6a9\uc790\uc5d0\uac8c \uc81c\uc791\uc790\uc758 \ud14c\uc2a4\ud2b8 \uae30\ub85d\u00b7\uc778\uc99d \uc815\ubcf4\u00b7PDF\ub97c \uc81c\uacf5\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.\n\n\uc124\uce58 \ud30c\uc77c: `DotoliAI-1.0-setup.exe`\n\n\uc790\ub3d9 \uc5c5\ub370\uc774\ud2b8 \uc124\uc815\uc5d0 \ub3d9\uc758\ud558\uba74 \uc720\ud6a8\ud55c \uc11c\uba85\uc73c\ub85c \ud655\uc778\ub41c \uc0c8 \ubc84\uc804\uc744 \uc800\uc7a5\u00b7\ubc31\uc5c5 \ud6c4 \uc124\uce58\ud569\ub2c8\ub2e4. Windows \uacf5\uc778 \uc81c\uc791\uc790 \ucf54\ub4dc \uc11c\uba85\uacfc\ub294 \ubcc4\uac1c\uc774\ubbc0\ub85c \ubcf4\uc548 \uacbd\uace0\uac00 \ud45c\uc2dc\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uacf5\uac1c \uc804 \uc2dc\ud5d8\uc6a9 v1.0\uc740 \ucd5c\uc885 \uc124\uce58\ubcf8\uc73c\ub85c \uc9c1\uc811 \uad50\uccb4\ud558\uc138\uc694. \uc774\ud6c4\uc5d0\ub294 v1.1\ubd80\ud130 \uc5c5\ub370\uc774\ud2b8\ud569\ub2c8\ub2e4. \ucd5c\uc2e0 \ub370\uc774\ud130\ub97c \uc774\uc804 \ubc84\uc804\uc73c\ub85c \uc5f4\uc9c0 \ub9c8\uc138\uc694.\n\nAI \uacb0\uacfc\uc5d0\ub294 \uc624\ub958\uac00 \uc788\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uac8c\uc2dc \uc804 \uc0ac\uc2e4\uacfc \ucd9c\ucc98\ub97c \ud655\uc778\ud574 \uc8fc\uc138\uc694. \uac80\uc0c9 \uc21c\uc704\u00b7\ubc29\ubb38\uc790 \uc218\u00b7\uc218\uc775\uc744 \ubcf4\uc7a5\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.\n","published_at":"2026-09-24T02:58:29.054155+00:00","schema_version":1,"sha256":"2f6459634387611d9164f62e9325820dec3f6ccc1ea105b1d0f2e1f9d25df517","size":409791930,"url":"https://github.com/daraming92/dotori_ai/releases/download/v1.0/DotoliAI-1.0-setup.exe","version":"1.0"},"hashes":{"sha256":"2f6459634387611d9164f62e9325820dec3f6ccc1ea105b1d0f2e1f9d25df517"},"length":409791930}},"version":1}}