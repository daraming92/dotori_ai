{"signatures":[{"keyid":"34c39d818f277dab7803f3d9cdc1b76848477f5070b519a9a6c48363c12cbd26","sig":"70c3beb5276fe973fed88cba09efa4c8c34c6331edaebeece2b3d751a58f751b7dbd76c460784ed95e9da86d2cfc58b03c496abdf82db4f6d9267e7b578ddf08"}],"signed":{"_type":"targets","expires":"2026-11-18T23:58:28Z","spec_version":"1.0.31","targets":{"DotoliAI-stable.exe":{"custom":{"channel":"stable","notes":"# \ub3c4\ud1a8\uc774 AI v1.1 \uc5c5\ub370\uc774\ud2b8\n\n\uae00 \uc791\uc131 \uc900\ube44\uc5d0\uc11c \ud655\ubcf4\ud55c \uc790\ub8cc\ub97c \ucd08\uc548\uc5d0 \ub354 \ucda9\uc2e4\ud558\uac8c \ud65c\uc6a9\ud558\uace0, \ubc18\ubcf5 \ud45c\ud604\uacfc \ucc98\ub9ac \uc2dc\uac04\uc744 \uc904\uc600\uc2b5\ub2c8\ub2e4. \uc11c\ub85c \ub3c5\ub9bd\uc801\uc778 \ubd84\uc11d\u00b7\uc791\uc131 \uc791\uc5c5\uc744 \ud568\uaed8 \uc9c4\ud589\ud560 \uc218 \uc788\ub3c4\ub85d \uc0ac\uc6a9 \ud3b8\uc758\uc131\ub3c4 \uac1c\uc120\ud588\uc2b5\ub2c8\ub2e4.\n\n## \ub2e4\uc6b4\ub85c\ub4dc\u00b7\uc5c5\ub370\uc774\ud2b8\n\n- \ucc98\uc74c \uc124\uce58\ud558\ub294 \ubd84\uc740 \uc544\ub798 Assets\uc758 **DotoliAI-1.1-setup.exe**\ub9cc \ub2e4\uc6b4\ub85c\ub4dc\ud574 \uc124\uce58\ud558\uc138\uc694. GitHub \ub85c\uadf8\uc778\uc740 \ud544\uc694\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.\n- v1.0 \uc0ac\uc6a9\uc790\ub294 \ud504\ub85c\uadf8\ub7a8\uc758 **\uc5c5\ub370\uc774\ud2b8 \ud655\uc778**\uc744 \uc774\uc6a9\ud558\uc138\uc694. \uc790\ub3d9 \uc124\uce58\ub97c \ucf20 \uacbd\uc6b0 \uc9c4\ud589 \uc911\uc778 \uc791\uc5c5\uc774 \ub05d\ub09c \ub4a4 \uc800\uc7a5\u00b7\ubc31\uc5c5\uacfc \uc5c5\ub370\uc774\ud2b8 \uac80\uc99d\uc744 \uac70\uccd0 \uc124\uce58\u00b7\uc7ac\uc2e4\ud589\ud569\ub2c8\ub2e4.\n- \uae30\uc874 \ube14\ub85c\uadf8\u00b7\ud0a4\uc6cc\ub4dc\u00b7\ucd08\uc548\uc740 \uc720\uc9c0\ub429\ub2c8\ub2e4. \uc0c8 \uc791\uc131 \uc815\ucc45\uc740 \uc5c5\ub370\uc774\ud2b8 \ud6c4 **\uc0c8 \ucd08\uc548 \uc791\uc131**\ubd80\ud130 \uc801\uc6a9\ub418\uba70, \uc800\uc7a5\ub41c \uae00\uc744 \uc790\ub3d9\uc73c\ub85c \ub2e4\uc2dc \uc4f0\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.\n- \ud45c\uc2dc \ubc84\uc804\uc774 \uc774\ubbf8 1.1\uc778 \uac1c\ubc1c\u00b7\uc2dc\ud5d8\ubcf8\uc740 \uac19\uc740 \ubc84\uc804\uc758 \ub2e4\ub978 \ud30c\uc77c\uc744 \uc790\ub3d9 \uad50\uccb4\ud558\uc9c0 \uc54a\uc73c\ubbc0\ub85c \uc791\uc5c5\uc744 \ubc31\uc5c5\ud558\uace0 \uacf5\uc2dd \uc124\uce58\ubcf8\uc744 \uc9c1\uc811 \uc124\uce58\ud558\uc138\uc694.\n\n## \uc8fc\uc694 \ubcc0\uacbd \uc0ac\ud56d\n\n### 1. \uc900\ube44 \uc790\ub8cc\uc640 \uc791\uc131 \uc694\uccad \ubc18\uc601 \uac15\ud654\n\n\uc2b9\uc778\ub41c \uc0ac\uc804 \uc9c0\uc2dd\u00b7\ucc28\ubcc4\ud654 \ubc29\ud5a5\u00b7\ud615\ud0dc\uc18c\uc640 \uad00\ub828 \uac1c\ub150\u00b7\ube14\ub85c\uadf8 \uc2a4\ud0c0\uc77c\u00b7\uc791\uc131 \uaddc\uce59\uc744 \ubb38\ub2e8\ubcc4 \uacc4\ud68d\uc5d0 \uc5f0\uacb0\ud588\uc2b5\ub2c8\ub2e4. \u2018\ub098\ub9cc\uc758 \uc791\uc131 \uc694\uccad\u2019\uacfc \u2018\uacbd\ud5d8\u00b7\ucd94\uac00 \uc694\uccad\u2019\uc774 \uc2e4\uc81c \ubcf8\ubb38\uc5d0 \ubc18\uc601\ub410\ub294\uc9c0 \ud655\uc778\ud558\uace0, \ub204\ub77d\ub41c \ub0b4\uc6a9\uc740 \uc2b9\uc778 \uc790\ub8cc \ubc94\uc704\uc5d0\uc11c \ubcf4\uc644\ud569\ub2c8\ub2e4. \ubcc4\ub3c4 \uc785\ub825 \ud0ed \uc5c6\uc774 \uae30\uc874 \u2018\uc0c8 \ucd08\uc548 \uc791\uc131\u2019\uc5d0\uc11c \ub3d9\uc791\ud569\ub2c8\ub2e4.\n\n### 2. \uc9c0\uc2dd \uae30\ubc18 \ud6c4\uae30\u00b7\uacbd\ud5d8\ud615 \uac1c\uc120\n\n\uc790\ub8cc\uc640 \ucc28\ubcc4\ud654 \ub0b4\uc6a9\uc744 \uad6c\uccb4\uc801\uc778 \uc0c1\ud669\u00b7\uad00\ucc30\u00b7\ud310\ub2e8\uc758 \ud750\ub984\uc73c\ub85c \ud480\ub3c4\ub85d \uac1c\uc120\ud588\uc2b5\ub2c8\ub2e4. \uc0ac\uc6a9\uc790\uac00 \uc785\ub825\ud55c \uc2e4\uc81c \uacbd\ud5d8\uc744 \uc6b0\uc120\ud569\ub2c8\ub2e4. \uc790\ub8cc\ub85c \uc0dd\uc131\ud55c \uc7a5\uba74\uc740 \uc2e4\uc81c \uad6c\ub9e4\u00b7\ubc29\ubb38\u00b7\uc0ac\uc6a9\uc758 \uc99d\uac70\uac00 \uc544\ub2c8\ubbc0\ub85c \ubc1c\ud589 \uc804\uc5d0 \ubcf8\uc778\uc758 \uc0ac\uc2e4\uad00\uacc4\uc640 \ub9de\ub294\uc9c0 \ud655\uc778\ud558\uc138\uc694.\n\n### 3. \ubc18\ubcf5 \ud45c\ud604\uacfc \ubd88\ud544\uc694\ud55c \uc8fc\uc758 \ubb38\uc7a5 \uc644\ud654\n\n\u2018~\uac00 \uc544\ub2c8\uc5d0\uc694\u2019, \u2018\ud655\uc815\ud560 \uc218 \uc5c6\uc5b4\uc694\u2019, \u2018\ub2e4\ub9cc\u2019, \u2018\ud655\uc778\ud558\uc138\uc694\u2019 \ub4f1\uc774 \ubc18\ubcf5\ub418\ub294 \uc804\uac1c\ub97c \uc810\uac80\ud558\uace0, \uadfc\uac70\uac00 \uc788\ub294 \ub0b4\uc6a9\uc740 \uad6c\uccb4\uc801\uc73c\ub85c \ubc14\ub85c \uc124\uba85\ud558\ub3c4\ub85d \uac1c\uc120\ud588\uc2b5\ub2c8\ub2e4. \ud544\uc694\ud55c \uac00\uaca9\u00b7\ub0a0\uc9dc\u00b7\uc548\uc804\u00b7\uc801\uc6a9 \uc870\uac74\uc740 \uc720\uc9c0\ud558\uba70 \ub2e8\uc5b4\ub97c \ubb34\uc870\uac74 \uc0ad\uc81c\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uae30\uc874 \uc5b4\uc870\u00b7\uc5b4\ud22c\uc640 \uae00 \uad6c\uc131 \uc120\ud0dd\ub3c4 \uc720\uc9c0\ud569\ub2c8\ub2e4.\n\n### 4. \ucd08\uc548 \uc791\uc131 \ud6a8\uc728\u00b7\uc624\ub958 \ubcf5\uad6c \uac1c\uc120\n\nAI\uc5d0 \uc804\ub2ec\ub418\ub294 \uc911\ubcf5 \uc785\ub825\uacfc \ub0b4\ubd80 \uacc4\ud68d\u00b7\uac80\uc218 \uc124\uba85\uc744 \uc904\uc600\uc2b5\ub2c8\ub2e4. \ubcf8\ubb38 \ubd84\ub7c9\uc774\ub098 \uc0ac\uc2e4\u00b7\ucd9c\ucc98 \uac80\uc218\ub97c \uc5c6\uc560\ub294 \ubc29\uc2dd\uc740 \uc544\ub2d9\ub2c8\ub2e4. \uc790\ub8cc \uc5f0\uacb0 \ud55c\ub3c4 \ub54c\ubb38\uc5d0 \uc791\uc131 \uacc4\ud68d\uc774 \uc911\ub2e8\ub418\ub358 \uc77c\ubd80 \uc624\ub958\ub97c \ubcf4\uc644\ud558\uace0, \uc800\uc7a5\ub41c \uc815\uc0c1 \ub2e8\uacc4\uc5d0\uc11c \uc774\uc5b4\uc4f0\uae30\uc640 \uad6c\uccb4\uc801\uc778 \uc2e4\ud328 \uc548\ub0b4\ub97c \uac15\ud654\ud588\uc2b5\ub2c8\ub2e4.\n\n\uac1c\ubc1c PC\uc758 \ub2e8\uc77c \ube44\uad50 \ud45c\ubcf8\uc5d0\uc11c\ub294 \ud55c \ucd08\uc548\uc774 \uc57d 12\ubd84 27\ucd08(\uc911\ub2e8\u00b7\uc7ac\uac1c \ud3ec\ud568)\uc5d0\uc11c \uc57d 7\ubd84 20\ucd08\ub85c \uc644\ub8cc\ub410\uc2b5\ub2c8\ub2e4. \ud3c9\uade0 \uc18d\ub3c4\ub098 \ubaa8\ub4e0 \uae00\uc758 \ucc98\ub9ac \uc2dc\uac04\uc744 \ubcf4\uc7a5\ud558\ub294 \uc218\uce58\ub294 \uc544\ub2c8\uba70 \ubaa8\ub378\u00b7\uc0ac\uc6a9\ub7c9\u00b7\uc790\ub8cc\ub7c9\u00b7\ub124\ud2b8\uc6cc\ud06c\uc5d0 \ub530\ub77c \ub2ec\ub77c\uc9d1\ub2c8\ub2e4.\n\n### 5. \uba54\ub274\ubcc4 \ub3c5\ub9bd \uc791\uc5c5\n\n\ud0a4\uc6cc\ub4dc \ud0d0\uc0c9 \uc911 \ub2e4\ub978 \uc790\ub8cc\uc758 \ubd84\uc11d\uc774\ub098 \uae00 \uc791\uc131\uc744 \uc9c4\ud589\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uba54\ub274\ubcc4 \uc2e4\ud589\u00b7\uc911\uc9c0\u00b7\uc7ac\uac1c\ub97c \ubd84\ub9ac\ud558\uace0 AI \uc791\uc5c5\uc740 \ucd5c\ub300 2\uac1c, \ub098\uba38\uc9c0\ub294 \ub300\uae30\ud558\ub3c4\ub85d \uad00\ub9ac\ud569\ub2c8\ub2e4. \uac19\uc740 \uc900\ube44 \uc790\ub8cc\ub97c \uc218\uc815\ud558\uba74\uc11c \ub3d9\uc2dc\uc5d0 \ucd08\uc548\uc5d0 \uc0ac\uc6a9\ud558\ub294 \uc791\uc5c5\uc740 \uc81c\ud55c\ud569\ub2c8\ub2e4. \uacc4\uc815\uc758 \ud638\ucd9c\u00b7\uc0ac\uc6a9\ub7c9 \ud55c\ub3c4\ub294 \uacc4\uc18d \uc801\uc6a9\ub429\ub2c8\ub2e4.\n\n### 6. \uc9c1\uc811 \ud0a4\uc6cc\ub4dc \ubd84\uc11d \ud654\uba74 \uac1c\uc120\n\n\ud558\ub2e8 \ud45c\uc5d0\uc11c \ud0a4\uc6cc\ub4dc\ub97c \uc120\ud0dd\ud558\uba74 **\uc6d4 \uac80\uc0c9\ub7c9 | \ube14\ub85c\uadf8 \ubb38\uc11c\uc218 | \ube44\uc728 | \ud0a4\uc6cc\ub4dc \ub4f1\uae09**\uc744 \uac00\ub85c \uce74\ub4dc\ub85c \ud45c\uc2dc\ud569\ub2c8\ub2e4. \ub4f1\uae09\uc740 \uc0c9\uc0c1\uacfc \uae00\uc790\ub85c \ud568\uaed8 \uad6c\ubd84\ud558\uba70 \ubbf8\ud655\uc778 \uc218\uce58\ub294 \uc784\uc758\ub85c \ucc44\uc6b0\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \ube44\uc728\uc740 \uac80\uc0c9 \uc0c1\uc704\ub178\ucd9c \ud655\ub960\uc774 \uc544\ub2d9\ub2c8\ub2e4.\n\n### 7. \ucd9c\ucc98 \ub9c1\ud06c\uc640 \uc774\ubbf8\uc9c0 \ud504\ub86c\ud504\ud2b8 \ubcf5\uc0ac \uac1c\uc120\n\n\ub3d9\uc77c\ud55c \uacf5\uac1c \ucd9c\ucc98 \ub9c1\ud06c\ub294 \uccab \uc0ac\uc6a9 \uc704\uce58\uc5d0 \ud55c \ubc88 \ud45c\uc2dc\ud558\ub3c4\ub85d \uc815\ub9ac\ud588\uc2b5\ub2c8\ub2e4. \uc11c\ub85c \ub2e4\ub978 \uacf5\uac1c \uc790\ub8cc\uac00 1\uac1c\uba74 1\uac1c, 2\uac1c\uba74 2\uac1c\uc758 \ucd9c\ucc98\ub97c \ud45c\uc2dc\ud558\uba70 \uc790\ub8cc \ud655\ubcf4 \ubc29\uc2dd\uc740 \ubcc0\uacbd\ud558\uc9c0 \uc54a\uc558\uc2b5\ub2c8\ub2e4. \ub274\uc2a4\u00b7\uacf5\uc2dd\uc790\ub8cc \ub9c1\ud06c\ub294 \uc720\uc9c0\ud558\uace0 \ube14\ub85c\uadf8 \ub9c1\ud06c \uc81c\uc678 \uc6d0\uce59\ub3c4 \uc720\uc9c0\ud569\ub2c8\ub2e4.\n\n\uc774\ubbf8\uc9c0 \uc0dd\uc131 \ud504\ub86c\ud504\ud2b8 \ubcf5\uc0ac\ub294 \ub300\ud45c \uc774\ubbf8\uc9c0\ub97c \ud3ec\ud568\ud574 **\ucd1d 5~10\uc7a5**\uc744 \uc9c0\uc815\ud558\uace0, \uc9c1\uc804\uc5d0 \uc9c0\uc815\ud55c \uc7a5\uc218\uc640 \ub2e4\ub974\uac8c \uc120\ud0dd\ud569\ub2c8\ub2e4. \uc571 \uc7ac\uc2e4\ud589 \ud6c4\uc5d0\ub3c4 \uc9c1\uc804 \uc218\ub7c9\uc744 \uae30\uc5b5\ud569\ub2c8\ub2e4. \uc774\ub294 \ubcf5\uc0ac\uc6a9 \ud504\ub86c\ud504\ud2b8 \uae30\ub2a5\uc774\uba70 \uc571\uc774 \uc9c1\uc811 \uc774\ubbf8\uc9c0\ub97c \uc0dd\uc131\ud558\ub294 \uae30\ub2a5\uc740 \uc544\ub2d9\ub2c8\ub2e4.\n\n### 8. \uc120\ud0dd \ub3d9\uc758 \uc548\ub0b4 \ud1b5\ud569\n\n\uc124\uce58\u00b7\uccab \uc2e4\ud589\u00b7\uc5f0\uacb0 \uc124\uc815\uc758 \uc120\ud0dd \ub3d9\uc758 \uc548\ub0b4\ub97c \ud1b5\ud569\ud588\uc2b5\ub2c8\ub2e4. \ud604\uc7ac\ub294 \uc120\ud0dd\uac12\ub9cc \uc0ac\uc6a9\uc790 PC\uc5d0 \uc800\uc7a5\ud558\uba70, \uccb4\ud06c \uc5ec\ubd80\uc640 \uad00\uacc4\uc5c6\uc774 \uac1c\ubc1c\uc790\uc5d0\uac8c \uc774\uc6a9 \ub0b4\uc5ed\uc744 \uc218\uc9d1\u00b7\uc804\uc1a1\ud558\ub294 \uae30\ub2a5\uc740 \ub3d9\uc791\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.\n\n### 9. \ud504\ub85c\uadf8\ub7a8 \ub0b4 \ub0a0\uc9dc\ubcc4 \uc5c5\ub370\uc774\ud2b8 \uacf5\uc9c0\n\n\u2018\uc5c5\ub370\uc774\ud2b8\u00b7\uacf5\uc9c0\u2019\uc5d0\uc11c \ub0a0\uc9dc\uc640 \ubc84\uc804\uc744 \ud568\uaed8 \ud45c\uc2dc\ud558\uace0 \ucd5c\uc2e0\uc21c\uc73c\ub85c \uc548\ub0b4\ud569\ub2c8\ub2e4. 2026-10-05 v1.1\uacfc 2026-09-24 v1.0 \ubc30\ud3ec \uc774\ub825\uc744 \uac01\uac01 \ud655\uc778\ud560 \uc218 \uc788\uc73c\uba70, \ub0a0\uc9dc\u00b7\ubc84\uc804\u00b7\uae30\ub2a5\uba85\uc73c\ub85c \uac80\uc0c9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uae30\uc874 \uc0ac\uc6a9 \uc548\ub0b4 33\uac1c\ub3c4 \uc720\uc9c0\ud569\ub2c8\ub2e4.\n\n## \uc774\uc6a9 \uc2dc \ud655\uc778\ud560 \uc810\n\n- AI \uac80\uc218 \ud310\ub2e8\uc774 \uc11c\ub85c \ub2ec\ub77c \ubcf4\uc644\ubcf8\uc744 \uc801\uc6a9\ud558\uc9c0 \uc54a\uace0 \uc6d0\ubcf8\uc744 \uc720\uc9c0\ud558\uac70\ub098 \ud655\uc778\uc744 \uc694\uccad\ud558\ub294 \uacbd\uc6b0\uac00 \ub0a8\uc544 \uc788\uc2b5\ub2c8\ub2e4. \ubaa8\ub4e0 \ud0a4\uc6cc\ub4dc\uc758 \ubc18\ubcf5\u00b7\uc624\ub958\uac00 \uc644\uc804\ud788 \ud574\uc18c\ub41c \uac83\uc740 \uc544\ub2d9\ub2c8\ub2e4.\n- \uc2e4\ud589 \uc2dc\uac04 \uc81c\ud55c\uacfc \uc800\uc7a5 \ud6c4 \uc7ac\uac1c, \uc0ac\uc2e4\u00b7\ucd9c\ucc98\u00b7\uacbd\ud5d8 \ud655\uc778\uc740 \uc720\uc9c0\ub429\ub2c8\ub2e4. AI \ub3d9\uc2dc \uc2e4\ud589\uc758 \uccb4\uac10 \uc131\ub2a5\uc740 \uacc4\uc815\ubcc4\ub85c \ub2e4\ub97c \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n- \uc678\ubd80 AI \uacc4\uc815\uacfc \ub124\uc774\ubc84 API \uc5f0\uacb0\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \ud504\ub85c\uadf8\ub7a8\uc740 \ubb34\ub8cc\uc774\uba70 \uc678\ubd80 \uc11c\ube44\uc2a4 \uc694\uae08\u00b7\uc0ac\uc6a9\ub7c9 \uc81c\ud55c\uc740 \ubcc4\ub3c4\uc785\ub2c8\ub2e4. Gemini\u00b7Claude \uc5f0\uacb0\uacfc macOS \uc124\uce58\ubcf8\uc740 \uc774\ubc88 \ubc84\uc804\uc5d0 \ud3ec\ud568\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.\n- \uc790\ub3d9 \ubc1c\ud589, \uc571 \ub0b4 \uc774\ubbf8\uc9c0 \uc0dd\uc131, \uac80\uc0c9 \uc21c\uc704\u00b7\ubc29\ubb38\uc790 \uc218\u00b7\uc218\uc775 \ubcf4\uc7a5\uc740 \uc81c\uacf5\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \ubc1c\ud589 \uc804 \ubcf8\ubb38\u00b7\ucd9c\ucc98\u00b7\uacbd\ud5d8 \uc0ac\uc2e4\uc744 \uc9c1\uc811 \ud655\uc778\ud558\uc138\uc694.\n- \uc5c5\ub370\uc774\ud2b8\ub294 TUF \uc11c\uba85\uacfc \ud30c\uc77c \ubb34\uacb0\uc131\uc744 \uac80\uc99d\ud569\ub2c8\ub2e4. Windows \uacf5\uc778 \ucf54\ub4dc\uc11c\uba85\uacfc\ub294 \ub2e4\ub974\uba70 \uc124\uce58 \ud30c\uc77c\uc740 Authenticode \ubbf8\uc11c\uba85\uc785\ub2c8\ub2e4. \ubcf4\uc548 \uacbd\uace0\ub098 \uc2e4\ud589 \uc81c\ud55c\uc774 \uc788\uc744 \uc218 \uc788\uc73c\ubbc0\ub85c \ubcf4\uc548 \uae30\ub2a5\uc744 \ub044\uc9c0 \ub9c8\uc138\uc694.\n- \ucd5c\uc2e0 \ubcc0\uacbd \uad00\ub828 \ud68c\uadc0 300\uac1c\uc640 \uaca9\ub9ac \ud328\ud0a4\uc9c0 \uae30\ubcf8 \uac80\uc0ac 5\uc885\uc744 \ud1b5\uacfc\ud588\uc2b5\ub2c8\ub2e4. \ubaa8\ub4e0 Windows \ud658\uacbd\u00b7\ubaa8\ub4e0 \uae00\uc758 \ud488\uc9c8\uc744 \uc778\uc99d\ud588\ub2e4\ub294 \ub73b\uc740 \uc544\ub2d9\ub2c8\ub2e4.\n\n\uc77c\ubc18 \uc0ac\uc6a9\uc790\ub294 \uc124\uce58 \ud30c\uc77c\ub9cc \ubc1b\uc73c\uba74 \ub429\ub2c8\ub2e4. \ub098\uba38\uc9c0 \ub77c\uc774\uc120\uc2a4\u00b7\uc18c\uc2a4 \uc790\ub8cc\ub294 \uace0\uae09 \uc0ac\uc6a9\uc790\uc640 \uc7ac\ubc30\ud3ec \uc870\uac74 \uc548\ub0b4\uc6a9\uc785\ub2c8\ub2e4. \ud504\ub85c\uadf8\ub7a8 \uc790\uccb4 \uc18c\uc2a4\u00b7PDF\u00b7\uac1c\uc778 \uc791\uc5c5\uc790\ub8cc\u00b7\ube44\ubc00\ud0a4\ub294 \uacf5\uac1c\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.\n\n\ubb38\uc758: dotoribas1@gmail.com \u2014 \uc571 \ubc84\uc804\u00b7\uc0ac\uc6a9 \uae30\ub2a5\u00b7\uc624\ub958 \ucf54\ub4dc\u00b7\uc7ac\ud604 \uc21c\uc11c\ub9cc \uc804\ub2ec\ud558\uace0 API \ud0a4\u00b7\uc778\uc99d \ud30c\uc77c\u00b7\uc791\uc5c5 DB\ub294 \ubcf4\ub0b4\uc9c0 \ub9c8\uc138\uc694.\n","published_at":"2026-10-04T23:58:28.166902+00:00","schema_version":1,"sha256":"51bd9bdb13950679b2e1dd786c145cb6e06ebeb16a33fb1f8a769332a1721f89","size":409883576,"url":"https://github.com/daraming92/dotori_ai/releases/download/v1.1/DotoliAI-1.1-setup.exe","version":"1.1"},"hashes":{"sha256":"51bd9bdb13950679b2e1dd786c145cb6e06ebeb16a33fb1f8a769332a1721f89"},"length":409883576}},"version":2}}